{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoOffice",
  "version": "0.1.0",
  "identifier": "com.nanooffice.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/EricNguyen1206/nanooffice/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFQkYxMEZBQzEwQUY1MzIKUldReTlRckIraEMvSHZVOXBxQVdhcXpRaXlQeXhJRmFTMXhXVVFGdi9lZUc1b3FZWGdMM0V3bisK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 NanoOffice contributors. Includes ONLYOFFICE components licensed under GNU AGPL v3.0.",
    "licenseFile": "../NOTICE",
    "resources": [
      "../NOTICE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["docx"],
        "name": "Microsoft Word Document",
        "description": "Microsoft Word Document",
        "role": "Editor"
      },
      {
        "ext": ["xlsx"],
        "name": "Microsoft Excel Spreadsheet",
        "description": "Microsoft Excel Spreadsheet",
        "role": "Editor"
      },
      {
        "ext": ["pptx"],
        "name": "Microsoft PowerPoint Presentation",
        "description": "Microsoft PowerPoint Presentation",
        "role": "Editor"
      },
      {
        "ext": ["pdf"],
        "name": "Portable Document Format",
        "description": "Portable Document Format",
        "role": "Viewer"
      }
    ]
  }
}
