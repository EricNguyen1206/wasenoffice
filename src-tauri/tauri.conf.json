{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WasenOffice",
  "version": "0.1.0",
  "identifier": "com.wasenoffice.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/EricNguyen1206/wasenoffice/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBOTZEQzkxOTI0Mzc4NDYKUldSR2VFT1NrZHlXMnFwdjhSaHAreHhQMXlGNllKUjUwWXh6TVhMNE96elFsWTZRTzZwb1kyamwK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "copyright": "Copyright © 2026 WasenOffice contributors. Includes ONLYOFFICE components licensed under GNU AGPL v3.0.",
    "licenseFile": "../NOTICE",
    "resources": [
      "../NOTICE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "docx"
        ],
        "name": "Microsoft Word Document",
        "description": "Microsoft Word Document",
        "role": "Editor"
      },
      {
        "ext": [
          "xlsx"
        ],
        "name": "Microsoft Excel Spreadsheet",
        "description": "Microsoft Excel Spreadsheet",
        "role": "Editor"
      },
      {
        "ext": [
          "pptx"
        ],
        "name": "Microsoft PowerPoint Presentation",
        "description": "Microsoft PowerPoint Presentation",
        "role": "Editor"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "Portable Document Format",
        "description": "Portable Document Format",
        "role": "Viewer"
      }
    ]
  }
}